# ==============================================================================
# Gokul's Astrological Insights - Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - frontend/.env.local (for Next.js frontend)
#   - backend/.env        (for FastAPI backend)
# Replace placeholder values with your actual project keys. Never commit real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Credentials
# ------------------------------------------------------------------------------
# Public Supabase credentials (used by browser client & server-side rendering)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key-placeholder

# Server-only credentials (used by API routes & backend; NEVER expose to browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-placeholder

# ------------------------------------------------------------------------------
# 2. Administrator Initial Provisioning Credentials
# ------------------------------------------------------------------------------
# Required for first-run idempotent administrator bootstrapping.
# The server provisioning script assigns role='admin' and must_change_password=true.
# The initial administrator is required to set a new password upon first login.
ADMIN_USERNAME=gokul_admin
ADMIN_EMAIL=admin@your-astrology-domain.com
ADMIN_INITIAL_PASSWORD=YourSecureInitialPassword#2026

# ------------------------------------------------------------------------------
# 3. Application API & Engine Settings
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend astronomical calculation service
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false
