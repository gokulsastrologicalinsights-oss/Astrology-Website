# Gokul's Astrological Insights - Backend Environment Template
# Copy to backend/.env and populate with your Supabase credentials.

# Supabase Credentials (server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-placeholder
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key-placeholder

# Initial Administrator Bootstrapping
ADMIN_USERNAME=gokul_admin
ADMIN_EMAIL=admin@your-astrology-domain.com
ADMIN_INITIAL_PASSWORD=YourSecureInitialPassword#2026

# FastAPI Server Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false

# Facebook Page Auto-Posting Integration
FB_PAGE_ID=your_facebook_page_numeric_id
FB_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token
FB_AUTO_POST_ENABLED=true
FB_POST_TIME_IST=06:00
FB_POST_RASHI=all
FB_POST_DELAY_SECONDS=20
FB_GRAPH_API_VERSION=v19.0
