# Gokul's Astrological Insights - Frontend Environment Template
# Copy to frontend/.env.local and populate with your Supabase credentials.

# Public Supabase credentials (used by browser client and SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key-placeholder

# Server-only credentials (used by API route handlers for secure username resolution & admin operations)
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-placeholder

# Admin bootstrap variables (used by `npm run bootstrap:admin`)
ADMIN_USERNAME=gokul_admin
ADMIN_EMAIL=admin@your-astrology-domain.com
ADMIN_INITIAL_PASSWORD=YourSecureInitialPassword#2026

# FastAPI backend calculation service
# Local development: http://127.0.0.1:8000
# Production (Render): https://gai-astrology-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
