{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "test:auth": "node scripts/test-auth-integration.mjs && node --env-file=.env.local scripts/test-live-supabase.mjs",
    "test:scenarios": "node --env-file=.env.local scripts/test-login-and-access-scenarios.mjs",
    "test:destiny-card": "node --experimental-strip-types scripts/test-destiny-card.mjs",
    "test:saved": "node --experimental-strip-types --env-file=.env.local scripts/test-saved-horoscopes.mjs",
    "test:transit-watch": "node scripts/test-transit-watch.mjs",
    "test:d1-d9": "node scripts/test-d1-d9.mjs",
    "test:dosha": "node scripts/test-dosha-ui-integration.mjs && node scripts/test-dosha-persistence-and-restoration.mjs",
    "test:marriage-prediction": "node scripts/test-marriage-prediction-frontend.mjs",
    "test:predictions": "node scripts/test-predictions-engine-frontend.mjs",
    "test:medical-astrology": "node --experimental-strip-types scripts/test-medical-astrology-frontend.mjs",
    "test:birth-time-12h": "node --experimental-strip-types scripts/test-birth-time-12h.mjs",
    "test:graha-colors": "node --experimental-strip-types scripts/test-graha-dignity-colors.mjs",
    "test:dasa-caution": "node scripts/test-dasa-caution-integration.mjs",
    "test": "node scripts/test-chart-correctness.mjs && node scripts/test-dasa-five-levels.mjs && node scripts/test-auth-integration.mjs && node --experimental-strip-types scripts/test-destiny-card.mjs && node scripts/test-transit-watch.mjs && node scripts/test-d1-d9.mjs && node scripts/test-dosha-ui-integration.mjs && node scripts/test-dosha-persistence-and-restoration.mjs && node scripts/test-predictions-engine-frontend.mjs && node --experimental-strip-types scripts/test-medical-astrology-frontend.mjs && node --experimental-strip-types scripts/test-birth-time-12h.mjs && node --experimental-strip-types scripts/test-graha-dignity-colors.mjs && node scripts/test-dasa-caution-integration.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
